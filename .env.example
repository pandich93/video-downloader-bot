# Токен от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot) — администратор: /stats, /ban, /restart, уведомления
ADMIN_ID=

# Кому можно пользоваться ботом. Пусто — бот открыт для всех.
# Список ID через запятую — только для этих людей (и администратора)
ALLOWED_USER_IDS=

# Публичный режим: лимиты для обычных пользователей (администратору — без лимитов)
DAILY_LIMIT=20
PUBLIC_MAX_FILE_MB=500
# Заблокированные ID через запятую (или командой /ban id в боте)
BLOCKED_USER_IDS=
# Сообщать администратору о каждом новом пользователе
NOTIFY_NEW_USERS=true

# Необязательно: cookies в формате Netscape (для Instagram / YouTube)
COOKIES_FILE=

# Папка для временных файлов и лимит размера (50 МБ — предел обычного Bot API)
DOWNLOAD_DIR=
MAX_FILE_MB=

# Прокси для TikTok (адрес из вашего VPN-клиента), например socks5://127.0.0.1:1080
PROXY=
PROXY_TYPE=

# Необязательно: большие файлы (до 2 ГБ) через MTProto.
# Ключи: my.telegram.org → API development tools. Никому их не передавайте.
API_ID=
API_HASH=

# Кодирование при обработке видео: auto (видеокарта Intel, если есть) | qsv | cpu
VIDEO_ENCODER=auto

# Уровень «🟣 Авторский»: фирменный цвет полосы прогресса и ваш ник на видео
BRAND_COLOR=#FF4D00
NICK=@pandich
